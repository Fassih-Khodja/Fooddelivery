<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".Activities.DataClasses.Code_verification">
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineTop"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidlineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.95" />
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineStart"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"/>
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineEnd"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        />
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidline75"
        app:layout_constraintGuide_percent="0.25"
        android:orientation="horizontal"
        />

    <TextView
        android:id="@+id/textverification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Verification"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        app:layout_constraintTop_toBottomOf="@id/guidlineTop" />

    <TextView
        android:id="@+id/textexplication"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textverification"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
        android:text="We have sent a code to your phone number"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginTop="15dp"
        />

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guidline75"
        android:layout_marginBottom="-25dp"
        app:cardCornerRadius="35dp"

        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <TextView
                android:id="@+id/textcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="68dp"
                android:text="Code"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <EditText
                  android:id="@+id/edittext1"
                  android:layout_width="50dp"
               android:layout_height="50dp"
                android:layout_marginStart="24dp"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintTop_toBottomOf="@id/textcode"
               app:layout_constraintEnd_toStartOf="@+id/edittext2"
                android:background="@drawable/codeverifybackground"
                android:layout_marginTop="4dp"
                android:inputType="number"
                android:singleLine="true"
                android:maxLength="1"
                android:gravity="center"

                />
            <EditText
                android:id="@+id/edittext2"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:layout_constraintStart_toEndOf="@+id/edittext1"
                app:layout_constraintTop_toBottomOf="@id/textcode"
                app:layout_constraintEnd_toStartOf="@+id/edittext3"
                android:background="@drawable/codeverifybackground"
                android:layout_marginTop="4dp"
                android:inputType="number"
                android:singleLine="true"
                android:maxLength="1"
                android:gravity="center"
                />
            <EditText
                android:id="@+id/edittext3"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:layout_constraintStart_toEndOf="@+id/edittext2"
                app:layout_constraintTop_toBottomOf="@id/textcode"
                app:layout_constraintEnd_toStartOf="@+id/edittext4"
                android:background="@drawable/codeverifybackground"
                android:layout_marginTop="4dp"
                android:inputType="number"
                android:singleLine="true"
                android:maxLength="1"
                android:gravity="center"
                />
            <EditText
                android:id="@+id/edittext4"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:layout_constraintStart_toEndOf="@+id/edittext3"
                app:layout_constraintTop_toBottomOf="@id/textcode"
                app:layout_constraintEnd_toStartOf="@+id/edittext5"
                android:background="@drawable/codeverifybackground"
                android:layout_marginTop="4dp"
                android:inputType="number"
                android:singleLine="true"
                android:maxLength="1"
                android:gravity="center"
                />
            <EditText
                android:id="@+id/edittext5"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:layout_constraintStart_toEndOf="@+id/edittext4"
                app:layout_constraintTop_toBottomOf="@id/textcode"
                app:layout_constraintEnd_toStartOf="@+id/edittext6"
                android:background="@drawable/codeverifybackground"
                android:layout_marginTop="4dp"
                android:inputType="number"
                android:singleLine="true"
                android:maxLength="1"
                android:gravity="center"
                />
            <EditText
                android:id="@+id/edittext6"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintStart_toEndOf="@+id/edittext5"
                app:layout_constraintTop_toBottomOf="@id/textcode"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/codeverifybackground"
                android:layout_marginTop="4dp"
                android:inputType="number"
                android:singleLine="true"
                android:maxLength="1"
                android:gravity="center"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/verifybtn"
                android:layout_width="0dp"
                android:layout_height="62dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/edittext1"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/mainbuttonbackground"
                android:text="verify"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"


                />



        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>