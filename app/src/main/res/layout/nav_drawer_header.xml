<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/photo_profile_nav_drawer"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/test"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"

        />
    <TextView
        android:id="@+id/user_name_text_nav_draw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/photo_profile_nav_drawer"
        android:layout_marginTop="25dp"
        android:text="Khodja Fassih"
        android:textColor="#181C2E"
        android:textSize="22sp"
        android:textStyle="bold"
        />

    <TextView
        android:id="@+id/user_email_text_nav_draw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/user_name_text_nav_draw"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/photo_profile_nav_drawer"
        android:layout_marginTop="10dp"
        android:text="fmidou59@gmail.com"
        android:textColor="#A0A5BA"
        android:textSize="16sp"
        android:textStyle="normal"
        />

</androidx.constraintlayout.widget.ConstraintLayout>