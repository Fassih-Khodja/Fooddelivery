<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragments.Profile">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidlineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineStart"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"/>
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineEnd"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        />
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineBottom"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="horizontal"
        />

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Profile"
    android:textColor="#181C2E"
    app:layout_constraintStart_toStartOf="@id/guidlineStart"
    app:layout_constraintTop_toTopOf="parent"
    android:layout_marginStart="70dp"
    android:textSize="19sp"
    android:layout_marginTop="10dp"
    />
    <TextView
        android:id="@+id/edit_prof_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EDIT"
        android:textColor="#FF7622"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
android:layout_marginEnd="15dp"
        android:layout_marginTop="13dp"
        />
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/profile_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/test"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        app:layout_constraintTop_toTopOf="@id/guidlineTop"
        android:layout_marginTop="25dp"
        />
    <TextView
        android:id="@+id/user_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/guidlineTop"
        app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
        app:layout_constraintStart_toEndOf="@id/profile_image"
        android:layout_marginTop="45dp"
        android:text="Khodja Fassih"
        android:textColor="#181C2E"
        android:textSize="22sp"
        android:textStyle="bold"
        />

      <TextView
        android:id="@+id/user_bio_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/user_name_text"
        app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
        app:layout_constraintStart_toEndOf="@id/profile_image"
        android:layout_marginTop="10dp"
        android:text="I love fast food"
        android:textColor="#A0A5BA"
        android:textSize="16sp"
        android:textStyle="normal"
        />
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="15dp"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
        app:layout_constraintTop_toBottomOf="@id/profile_image"
        android:layout_marginTop="30dp"
        android:backgroundTint="#F6F8FA"
        >
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|center_horizontal"
                    android:src="@drawable/profile_icon"
                    android:background="@drawable/profile_icon_test"
                    />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|top"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp"

                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textColor="#32343E"
                        android:textSize="16sp"
                        />
                    <TextView
                        android:id="@+id/user_name_text2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khodja m'hand fassih"
                        android:textColor="#6B6E82"
                        android:textSize="16sp"
                        />
                </LinearLayout>



            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp"
                >
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/profile_icon_test"
                    android:layout_gravity="center|start"
                    android:src="@drawable/email_icon_profile"

                    />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|top"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp"
                    >
                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textColor="#32343E"
                        android:textSize="16sp"
                        />
                    <TextView
                        android:id="@+id/user_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="hello@halallab.com"
                        android:textColor="#6B6E82"
                        android:textSize="16sp"
                        />
                </LinearLayout>

            </LinearLayout>

  <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp"
                >
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/profile_icon_test"
                    android:layout_gravity="center|start"
                    android:src="@drawable/phone_nbr_profile"
                    />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|top"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Number"
                        android:textColor="#32343E"
                        android:textSize="16sp"
                        />
                    <TextView
                        android:id="@+id/user_phone_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="408-841-0926"
                        android:textColor="#6B6E82"
                        android:textSize="16sp"
                        />
                </LinearLayout>

            </LinearLayout>



        </LinearLayout>



    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>