<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121223"
    tools:context=".Activities.DataClasses.My_Cart">
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineTop"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidlineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.95" />
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineStart"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"/>
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineEnd"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        />

    <TextView
        android:id="@+id/carttext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cart"
        app:layout_constraintTop_toTopOf="@id/guidlineTop"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        android:layout_marginStart="67dp"
        android:textSize="17sp"
        android:layout_marginTop="10dp"
        android:textColor="@color/white"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mycartrecyclerview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        app:layout_constraintTop_toBottomOf="@id/carttext"
        app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
        app:layout_constraintBottom_toTopOf="@id/cardviewmycart"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="10dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        />
    <androidx.cardview.widget.CardView
        android:id="@+id/cardviewmycart"
        android:layout_width="0dp"
        android:layout_height="310dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardCornerRadius="25dp"
        android:backgroundTint="#F0F5FA"
        android:layout_marginBottom="-17dp"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delivery Address"
            android:textColor="#A0A5BA"
            android:textSize="16sp"
            android:layout_gravity="top|start"
            android:layout_marginTop="30dp"
            android:layout_marginStart="25dp"/>
        <TextView
            android:id="@+id/edit_text_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDIT"
android:textColor="#FF7622"
            android:textSize="16sp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="30dp"
            />

        <TextView
            android:id="@+id/text_current_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YOUR LOCATION HERE"
            android:textColor="#7B7F8E"
            android:textSize="15sp"
            android:layout_gravity="center_vertical|center_horizontal"
            android:layout_marginBottom="60dp"
            android:paddingVertical="20dp"
            android:paddingHorizontal="5dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="14sp"
            android:layout_marginHorizontal="28dp"
            android:background="#E7EFF6"
android:textStyle="normal"
            android:maxLines="2"
            />
<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Total: "
    android:layout_gravity="center_vertical|start"
    android:layout_marginStart="25dp"
    android:textColor="#A0A5BA"
    android:textSize="18sp"
    />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/placeorderbtn"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginHorizontal="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="55dp"
            android:background="@drawable/mainbuttonbackground"
            android:text="Place order"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>