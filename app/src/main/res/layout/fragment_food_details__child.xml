<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragments.FoodDetails_Child">


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidlineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineStart"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"/>
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineEnd"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/cardviewfooddetail"
        app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        app:layout_constraintTop_toTopOf="parent"
        android:scrollbars="none"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_food_detail"
                android:layout_width="0dp"
                android:layout_height="275dp"
                android:src="@drawable/introimage2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
            android:theme="@style/ImageView.Corner"
                android:transitionName="image_food_transition"
                android:scaleType="centerCrop"/>
            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:src="@drawable/selectore_for_favoriteicon"
                android:background="@android:color/transparent"
                />

            <TextView
                android:id="@+id/name_food_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Burger Bistro"
                app:layout_constraintStart_toStartOf="parent"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginStart="20dp"
                app:layout_constraintTop_toBottomOf="@id/image_food_detail" />
            <ImageView
                android:id="@+id/startimage_food_detail"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/name_food_details"
                android:layout_marginTop="10dp"
                android:src="@drawable/star_food"
                android:layout_marginStart="20dp"
                />
            <TextView
                android:id="@+id/star_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/name_food_details"
                app:layout_constraintStart_toEndOf="@id/startimage_food_detail"
                android:text="5.0"
                android:layout_marginTop="10dp"
                android:layout_marginStart="4dp"
                android:textSize="16sp"
                android:textStyle="bold"
                />
            <ImageView
                android:id="@+id/foodclock"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/clock_food"
                app:layout_constraintTop_toBottomOf="@id/name_food_details"
                app:layout_constraintStart_toEndOf="@id/star_text"
                android:layout_marginTop="10dp"
                android:layout_marginStart="18dp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/name_food_details"
                app:layout_constraintStart_toEndOf="@id/foodclock"
                android:text="20 min"
                android:layout_marginTop="10dp"
                android:layout_marginStart="4dp"
                android:textSize="16sp"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/discription_food_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/startimage_food_detail"
                android:layout_marginStart="20dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="20dp"
                android:textColor="#A0A5BA"
                android:text="Maecenas sed diam risus varius blandit sit amet non magna. Integer posuere erat a ante venenatis dapibus posuere velit aliquet."

                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

<androidx.cardview.widget.CardView
    android:id="@+id/cardviewfooddetail"
    android:layout_width="0dp"
    android:layout_height="160dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:cardCornerRadius="25dp"
    android:backgroundTint="#F0F5FA"
    android:layout_marginBottom="-17dp"
    >
<TextView
    android:id="@+id/totalprice_food_detail"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textColor="#181C2E"
    android:text="$0"
    android:textSize="28sp"
    android:layout_marginStart="40dp"
    android:layout_marginTop="15dp"
    />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/addcart_btn"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginHorizontal="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/mainbuttonbackground"
        android:text="Add to cart"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:layout_width="125dp"
        android:layout_height="48dp"
        app:cardCornerRadius="30dp"
        android:backgroundTint="@color/black"
        android:layout_gravity="end"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="13dp"
        >

        <TextView
            android:id="@+id/quantitytext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/minus_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="13dp"
            android:src="@drawable/minus_btn_icon"
            android:background="@color/black"
            />
        <ImageButton
            android:id="@+id/plus_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="13dp"
            android:src="@drawable/plus_btn_icon"
            android:background="@color/black"
            />

    </androidx.cardview.widget.CardView>

</androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>