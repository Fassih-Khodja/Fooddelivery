<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/Datetext"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="15dp"
        android:layout_marginTop="5dp"
        android:background="@color/shimmerColor"
        />

    <TextView
        android:id="@+id/totalpricetext"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="80dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="5dp"
        android:background="@color/shimmerColor"/>
    <TextView
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/totalpricetext"
        android:layout_marginStart="5dp"
        app:layout_constraintTop_toTopOf="parent"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="5dp"
        android:background="@color/shimmerColor"
        />



    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Datetext"
        android:id="@+id/orderslinearlayout"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/foodimage"
            android:layout_width="136dp"
            android:layout_height="117dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ImageView.Corner"
            android:scaleType="centerCrop"
            android:background="@color/shimmerColor"/>

        <TextView
            android:id="@+id/foodname"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:background="@color/shimmerColor"
            android:textColor="#181C2E"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/foodimage"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"/>
        <TextView
            android:id="@+id/foodpricetotal"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:background="@color/shimmerColor"
            android:textColor="#181C2E"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/foodimage"
            app:layout_constraintTop_toBottomOf="@id/foodname"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"/>
        <TextView
            app:layout_constraintStart_toEndOf="@id/foodimage"
            app:layout_constraintTop_toBottomOf="@id/foodpricetotal"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:background="@color/shimmerColor"
            android:layout_marginStart="20dp"
            android:layout_marginTop="7dp"
            android:textColor="#6B6E82"
            android:textSize="12sp"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/orderslinearlayout"
        android:background="@color/shimmerColor"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="20dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/orderslinearlayout"
        android:background="@color/shimmerColor"
        android:textColor="#FF7622"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>