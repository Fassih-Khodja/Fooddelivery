<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/foodimage"
        android:layout_width="match_parent"
        android:layout_height="137dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="centerCrop"
        android:theme="@style/ImageView.Corner"
        android:background="@color/shimmerColor"
        />

    <TextView
        android:id="@+id/foodname"
        android:layout_width="129dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/foodimage"
        android:background="@color/shimmerColor"

        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/foodprice"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/foodname"
        android:background="@color/shimmerColor"
        android:layout_marginTop="6dp"/>
    <ImageView
        android:id="@+id/startimage"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/foodprice"
        android:layout_marginTop="10dp"
        android:background="@color/shimmerColor"
        />
    <TextView
        android:id="@+id/star_text"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/foodprice"
        app:layout_constraintStart_toEndOf="@id/startimage"
        android:layout_marginTop="10dp"
        android:layout_marginStart="4dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@color/shimmerColor"
        />
    <ImageView
        android:id="@+id/foodclock"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintTop_toBottomOf="@id/foodprice"
        app:layout_constraintStart_toEndOf="@id/star_text"
        android:layout_marginTop="10dp"
        android:layout_marginStart="18dp"
        android:background="@color/shimmerColor"
        />
    <TextView
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/foodprice"
        app:layout_constraintStart_toEndOf="@id/foodclock"
        android:layout_marginTop="10dp"
        android:layout_marginStart="4dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@color/shimmerColor"
        />


</androidx.constraintlayout.widget.ConstraintLayout>