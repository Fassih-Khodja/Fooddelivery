<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragments.Home_fragment"

    >


<androidx.constraintlayout.widget.ConstraintLayout

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidlineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineStart"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"/>
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guidlineEnd"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        />

    <TextView
        android:id="@+id/welcometext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hey "
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        android:textSize="16sp"
        />
    <TextView
        android:id="@+id/nametext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/welcometext"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Fassih ,"
        android:textSize="16sp"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/nametext"
        app:layout_constraintTop_toTopOf="parent"
        android:text=" Good afternoon "
        android:textStyle="bold"
        android:textSize="16sp"
        />
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpagerOffers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/welcometext"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
        android:layout_marginTop="20dp"
        />
    <TextView
        android:id="@+id/CategoriesText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="All Categories"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        app:layout_constraintTop_toBottomOf="@id/viewpagerOffers"
        android:layout_marginTop="20dp"
        />

    <FrameLayout
        android:id="@+id/containercategories"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
        app:layout_constraintTop_toBottomOf="@+id/CategoriesText"
        android:layout_marginTop="10dp"

        >
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerviewcategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone"
            />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never"
            >

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_layout_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/shimmer_categorie_item_home"/>
                    <include layout="@layout/shimmer_categorie_item_home"/>
                    <include layout="@layout/shimmer_categorie_item_home"/>

                </LinearLayout>

            </com.facebook.shimmer.ShimmerFrameLayout>

        </HorizontalScrollView>

    </FrameLayout>






    <TextView
        android:id="@+id/bestsellertext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Best Seller"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        app:layout_constraintTop_toBottomOf="@id/containercategories"
        android:layout_marginTop="15dp"
        android:textSize="20sp"
        />

    <FrameLayout
        android:id="@+id/containerbestseller"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
        app:layout_constraintTop_toBottomOf="@id/bestsellertext"
        android:layout_marginTop="10dp"

        >
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerviewbestseller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/guidlineStart"
            app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
            app:layout_constraintTop_toBottomOf="@id/bestsellertext"
            android:scrollbars="none"
            android:visibility="gone"
            />
<HorizontalScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never"
    >
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_layout_best_seller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <include layout="@layout/shimmer_bestseller_item_home"/>
            <include layout="@layout/shimmer_bestseller_item_home"/>
            <include layout="@layout/shimmer_bestseller_item_home"/>
            <include layout="@layout/shimmer_bestseller_item_home"/>

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>
</HorizontalScrollView>





    </FrameLayout>





    <TextView
        android:id="@+id/foodtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Food"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        app:layout_constraintTop_toBottomOf="@id/containerbestseller"
        android:layout_marginTop="20dp"
        />


    <FrameLayout
        android:id="@+id/containerfood"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/guidlineStart"
        app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
        app:layout_constraintTop_toBottomOf="@id/foodtext"
        android:layout_marginTop="10dp"
        >
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerviewfood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/guidlineStart"
            app:layout_constraintEnd_toEndOf="@id/guidlineEnd"
            app:layout_constraintTop_toBottomOf="@id/foodtext"
            android:visibility="gone"
            />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_layout_foods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <include layout="@layout/shimmer_item_foods_home"/>
                <include layout="@layout/shimmer_item_foods_home"/>
                <include layout="@layout/shimmer_item_foods_home"/>

            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>
    </FrameLayout>













</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>