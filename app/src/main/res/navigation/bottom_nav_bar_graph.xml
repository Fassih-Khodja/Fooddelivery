<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav_bar_graph"
    app:startDestination="@id/home">
    <fragment
        android:id="@+id/home"
        android:name="com.example.fastdelivery.Fragments.Home_fragment"
        android:label="Home"

        >
        <action
            android:id="@+id/action_homeFragment_to_foodDetailsChild"
            app:destination="@id/foodDetailsChild"
            app:launchSingleTop="true"
            app:popUpTo="@id/home"
            app:popUpToInclusive="false"
            app:popUpToSaveState="true"
            app:restoreState="true"
            />
    </fragment>
    <fragment
        android:id="@+id/orders"
        android:name="com.example.fastdelivery.Fragments.My_Orders"
        android:label="Orders"
        >
    </fragment>
    <fragment
        android:id="@+id/favorite"
        android:name="com.example.fastdelivery.Fragments.Favorit"
        android:label="Favorit"
        >
    </fragment>
    <fragment
        android:id="@+id/foodDetailsChild"
        android:name="com.example.fastdelivery.Fragments.FoodDetails_Child"
        android:label="FoodDetailsChild"
        />
    <fragment
        android:id="@+id/search"
        android:name="com.example.fastdelivery.Fragments.Search"
        android:label="Search"
        >
        <action
            android:id="@+id/action_searchFragment_to_foodDetailsChild"
            app:destination="@id/foodDetailsChild"
            />
    </fragment>
</navigation>